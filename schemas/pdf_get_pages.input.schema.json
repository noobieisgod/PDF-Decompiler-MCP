{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "documentId": {
      "type": "string",
      "pattern": "^doc_[a-f0-9]{64}$",
      "description": "Identifier derived from the exact PDF bytes."
    },
    "extractionFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Exact extraction generation to resolve."
    },
    "pages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "pageRanges": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "text",
        "balanced",
        "fidelity"
      ]
    },
    "includeElementTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "block",
          "table",
          "figure",
          "annotation",
          "link"
        ]
      }
    },
    "excludeElementTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "block",
          "table",
          "figure",
          "annotation",
          "link"
        ]
      }
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "responseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "textBlocks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tables": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "figures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "renderedPages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "imageDimension": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "documentId",
    "extractionFingerprint"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/noobieisgod/PDF-Decompiler-MCP/schemas/pdf_get_pages.input.schema.json"
}
