{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "documentId": {
      "type": "string",
      "pattern": "^doc_[a-f0-9]{64}$",
      "description": "Identifier derived from the exact PDF bytes."
    },
    "extractionFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Exact extraction generation to resolve."
    },
    "elementId": {
      "type": "string",
      "minLength": 1
    },
    "tableSelection": {
      "type": "object",
      "properties": {
        "rowStart": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rowEnd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "columnStart": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "columnEnd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "includeHeaders": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "responseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "textBlocks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tables": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "figures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "renderedPages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "imageDimension": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "documentId",
    "extractionFingerprint",
    "elementId"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/noobieisgod/PDF-Decompiler-MCP/schemas/pdf_get_element.input.schema.json"
}
