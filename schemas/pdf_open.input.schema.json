{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "sourceLabel": {
      "type": "string",
      "maxLength": 128
    },
    "sourceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "pages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      }
    },
    "maxImageDimension": {
      "type": "integer",
      "minimum": 64,
      "maximum": 4096
    },
    "refresh": {
      "type": "boolean"
    },
    "ocrPolicy": {
      "type": "string",
      "enum": [
        "auto",
        "off",
        "required"
      ]
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    },
    "documentId": {
      "type": "string",
      "pattern": "^doc_[a-f0-9]{64}$"
    },
    "extractionFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "$id": "https://github.com/noobieisgod/PDF-Decompiler-MCP/schemas/pdf_open.input.schema.json"
}
